extends RefCounted

static func run(g: Node) -> void:
	var checkpoint: String=g.artifact_path("test-narrative-save.json")
	for delivery in ["first","together"]:
		for future in ["breakfast","space",""]:
			g.reset_game();g.v2_started=true;g.intro_done=true;g.typewriter=false
			for key in g.REQUIRED: g.collect(key,false)
			for claim in g.Story.CLAIMS: g.combine_evidence(g.Story.CLAIMS[claim].pair)
			g.truth_scene()
			g.save_game(checkpoint,true)
			g.apply_save(JSON.parse_string(FileAccess.get_file_as_string(checkpoint)));g.resume_chapter()
			g.check(g.choice_locked and g.pending_event=="truth","truth checkpoint resumes without granting completion")
			g.deliver_truth(delivery);g.drain_dialog()
			g.check(g.flags.get("truth") and g.decisions.truth==delivery,"truth branch "+delivery)
			g.choose_topic("song","future")
			g.check("现在我知道" in g.current_lines[0][1],"revisiting Song acknowledges delivered truth")
			g.drain_dialog();g.close_modal()
			if future!="":
				for key in ["bread","lease","consent","pressure"]: g.investigate_side(key);g.drain_dialog();g.close_modal()
				g.future_scene();g.drain_dialog()
				g.save_game(checkpoint,true);g.apply_save(JSON.parse_string(FileAccess.get_file_as_string(checkpoint)));g.resume_chapter();g.drain_dialog()
				g.check(g.choice_locked and not g.decisions.has("future"),"unfinished life choice resumes without inventing a decision")
				g.choose_future(future);g.drain_dialog()
				g.check(g.decisions.future==future,"life choice "+future)
			for claim in ["replacement","operator","motive"]: g.submit_claim(claim)
			g.finish_case("independent")
			g.check(not g.completed and g.identity_choice=="","identity cannot bypass custody")
			g.custody_scene();g.drain_dialog()
			g.save_game(checkpoint,true);g.apply_save(JSON.parse_string(FileAccess.get_file_as_string(checkpoint)));g.resume_chapter();g.drain_dialog()
			g.check(g.choice_locked and not g.flags.custody,"custody checkpoint requires disposition")
			g.choose_report("system")
			if future=="":
				g.check(not g.dialog_mode and not g.flags.custody,"system request requires researched records")
				g.choose_report("case")
			g.drain_dialog()
			g.enter_scene("corridor",false);g.choose_topic("shao","restore")
			g.check("不能再" in g.current_lines[0][1],"Shao stops denying after evidence handover")
			g.drain_dialog();g.close_modal()
			g.finish_case("independent");g.drain_dialog()
			g.check(not g.completed and g.pending_event=="ending","ending complete only after reveal")
			g.save_game(checkpoint,true);g.apply_save(JSON.parse_string(FileAccess.get_file_as_string(checkpoint)));g.resume_chapter();g.drain_dialog()
			g.check(g.choice_locked and is_instance_valid(g.horizon_layer),"interrupted ending resumes to boundary")
			preload("res://scripts/playthrough_test.gd").find_button(g,"查看维护窗口与清理附页").pressed.emit();g.drain_dialog()
			g.check(g.completed and g.pending_event=="","reveal closes complete chapter")
			g.check(("配方" in str(g.epilogue_lines()))==(future=="breakfast"),"breakfast consequence appears only in chosen branch")
			g.check(("延期申请" in str(g.epilogue_lines()))==(future=="space"),"space consequence appears only in chosen branch")
	g.reset_game();g.start_new();g.save_game(checkpoint,true)
	g.apply_save(JSON.parse_string(FileAccess.get_file_as_string(checkpoint)));g.resume_chapter()
	g.check(is_instance_valid(g.opening_layer),"opening checkpoint resumes before arrival")
	g.opening_layer.finish();g.drain_dialog()
	g.check(g.intro_done and g.pending_event=="","arrival interruption resumes event")
	g.check(not g.apply_save({"version":2,"evidence":[]}),"legacy save is preserved rather than misinterpreted")
